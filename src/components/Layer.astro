---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  src: ImageMetadata;
  x: number;
  y: number;
  w: number;
  alt?: string;
  priority?: boolean;
  class?: string;
}

const { src, x, y, w, alt = "", priority = false, class: className } = Astro.props;

const widths = [...new Set([0.25, 0.5, 0.75, 1].map((f) => Math.round(src.width * f)))];
---

<Image
  src={src}
  alt={alt}
  widths={widths}
  sizes={`${(w * 100).toFixed(1)}vw`}
  loading={priority ? "eager" : "lazy"}
  fetchpriority={priority ? "high" : "auto"}
  class:list={["at", "layer", className]}
  style={{ left: `${x * 100}%`, top: `${y * 100}%`, width: `${w * 100}%` }}
/>

<style>
  .layer {
    height: auto;
    pointer-events: none;
    user-select: none;
  }
</style>
