---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  src: ImageMetadata;
  x: number;
  y: number;
  w: number;
  alt?: string;
  priority?: boolean;
}

const { src, x, y, w, alt = "", priority = false } = Astro.props;

// Scale the candidates to the layer's share of the viewport. Keep the original for high-density displays.
const widths = [720, 1440, 2160].map((viewportWidth) => Math.ceil(viewportWidth * w));
widths.push(src.width);
---

<Image
  src={src}
  alt={alt}
  widths={widths}
  sizes={`${(w * 100).toFixed(2)}vw`}
  priority={priority}
  class="at layer"
  style={{ left: `${x * 100}%`, top: `${y * 100}%`, width: `${w * 100}%` }}
/>

<style>
  .layer {
    height: auto;
    pointer-events: none;
    user-select: none;
  }
</style>
