---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"section"> & {
  ratio?: number;
  mobileRatio?: number;
  bg: string;
};

const { ratio = 1411 / 793, mobileRatio, bg, class: className, ...rest } = Astro.props;
---

<section
  class:list={["stage", className]}
  data-bg={bg}
  style={{ "--ratio": ratio, ...(mobileRatio ? { "--mratio": mobileRatio } : {}) }}
  {...rest}
>
  <slot />
</section>

<style>
  .stage {
    position: relative;
    width: 100%;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    container-type: inline-size;
  }

  @media (max-width: 759.98px) {
    .stage {
      aspect-ratio: var(--mratio, auto);
    }
  }
</style>
