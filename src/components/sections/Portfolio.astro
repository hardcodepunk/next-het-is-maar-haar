---
import Stage from "../Stage.astro";
import Layer from "../Layer.astro";
import { place } from "../place";
import { site } from "../../data/site";

import starsALeft from "../../assets/portfolio/stars-a-left.webp";
import starsARight from "../../assets/portfolio/stars-a-right.webp";
import frameStreet from "../../assets/portfolio/frame-street.webp";
import frameFlowers from "../../assets/portfolio/frame-flowers.webp";
import frameStars from "../../assets/portfolio/frame-stars.webp";
import frameSmileys from "../../assets/portfolio/frame-smileys.webp";
import frameLaugh from "../../assets/portfolio/frame-laugh.webp";
import clouds from "../../assets/portfolio/clouds.webp";
import rainbow from "../../assets/portfolio/rainbow.webp";

import starsBLeft from "../../assets/portfolio/stars-b-left.webp";
import frameFruit from "../../assets/portfolio/frame-fruit.webp";
import starsBRight from "../../assets/portfolio/stars-b-right.webp";
import frameCreateArt from "../../assets/portfolio/frame-create-art.webp";
import framePinkBlob from "../../assets/portfolio/frame-pink-blob.webp";
import frameBlueBlob from "../../assets/portfolio/frame-blue-blob.webp";
import frameHearts from "../../assets/portfolio/frame-hearts.webp";
import frameTropical from "../../assets/portfolio/frame-tropical.webp";

const alt = "Portfolio haircut";
---

<Stage id="portfolio" aria-labelledby="portfolio-title">
  <Layer src={starsALeft} x={0} y={0} w={0.3565} />
  <Layer src={starsARight} x={0.8444} y={0.0687} w={0.1556} />
  <Layer src={frameStreet} x={0.4135} y={0.355} w={0.2144} alt={alt} />
  <Layer src={frameFlowers} x={0.0978} y={0.2711} w={0.2562} alt={alt} />
  <Layer src={frameStars} x={0.7069} y={0.162} w={0.185} alt={alt} />
  <Layer src={frameSmileys} x={0.7264} y={0.6728} w={0.2346} alt={alt} />
  <Layer src={frameLaugh} x={0.1598} y={0.6873} w={0.1967} alt={alt} />
  <Layer src={clouds} x={0.4103} y={0.0511} w={0.1627} />
  <Layer src={rainbow} x={0} y={0} w={0.2509} />

  <h2 id="portfolio-title" class="at heading" style={place(0.4165, 0.1073, 0.1671, 0.0591)}>
    {site.portfolio.title}
  </h2>

  <p class="at motto lines" style={place(0.0298, 0.0377, 0.1694, 0.1302, -10.55)}>
    {site.portfolio.motto.map((line) => <span>{line}</span>)}
  </p>
</Stage>

<Stage aria-label="More portfolio">
  <Layer src={starsBLeft} x={0} y={0.0315} w={0.5588} />
  <Layer src={frameFruit} x={0.4089} y={0.1255} w={0.258} alt={alt} />
  <Layer src={starsBRight} x={0.6517} y={0.0794} w={0.3203} />
  <Layer src={frameCreateArt} x={0.1215} y={0.1255} w={0.2325} alt={alt} />
  <Layer src={framePinkBlob} x={0.5687} y={0.5946} w={0.196} alt={alt} />
  <Layer src={frameBlueBlob} x={0.0751} y={0.5006} w={0.1623} alt={alt} />
  <Layer src={frameHearts} x={0.3065} y={0.553} w={0.1931} alt={alt} />
  <Layer src={frameTropical} x={0.7356} y={0.1009} w={0.1878} alt={alt} />
</Stage>

<style>
  .heading {
    display: grid;
    place-items: center;
    font-family: var(--font-serif);
    font-weight: 900;
    font-variation-settings: "SOFT" 100, "WONK" 0;
    font-size: 2.8cqi;
    line-height: 1;
    white-space: nowrap;
    color: var(--cyan);
    text-shadow: 0.15cqi 0.15cqi 0 var(--maroon);
  }

  .motto {
    display: grid;
    align-content: center;
    text-align: center;
    font-size: 1.12cqi;
    line-height: 1.54cqi;
    white-space: nowrap;
    color: var(--aqua);
    filter: drop-shadow(0 0 0.02cqi rgb(0 125 129 / 0.95)) drop-shadow(0 0 0.09cqi rgb(0 125 129 / 0.75))
      drop-shadow(0 0 0.28cqi rgb(0 125 129 / 0.44));
  }
</style>
