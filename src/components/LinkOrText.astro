---
import type { Link } from "../data/site";

interface Props {
  link: Link;
}

const { link } = Astro.props;
---

{
  link.href ? (
    <a
      href={link.href}
      {...(link.external ? { target: "_blank", rel: "noreferrer" } : {})}
    >
      {link.label}
    </a>
  ) : (
    <span>{link.label}</span>
  )
}
